# Optional outside Vercel. Use the verified public production origin.
# SITE_URL=https://michaelpgibb.com
# INDEXABLE_PRODUCTION=true

# Private server-only production configuration. Never use NEXT_PUBLIC_ prefixes.
# Set real values in Vercel; leave committed examples blank.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CONTACT_HASH_SECRET=

# Turnstile Managed widget. The sitekey is public; all other values stay server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=michaelpgibb.com,www.michaelpgibb.com

# Optional research assistant; leave disabled until API billing is approved.
AI_ENABLED=false
OPENAI_API_KEY=
AI_DAILY_REQUEST_LIMIT=100
AI_DAILY_TOKEN_LIMIT=200000
AI_DAILY_COST_MICRODOLLARS=500000

# Optional analytics/replay. Public ingestion token is distinct from private admin key.
ANALYTICS_ENABLED=false
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=
ANALYTICS_DAILY_EVENT_LIMIT=1000
REPLAY_ENABLED=false
REPLAY_SAMPLE_RATE=0.1
INQUIRY_RETENTION_DAYS=90

# Owner-only GitHub OAuth. Confirmed account mpgibb; numeric ID is checked server-side.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=
AUTH_URL=https://michaelpgibb.com
OWNER_GITHUB_ID=4212420
RESEND_WEBHOOK_SECRET=
